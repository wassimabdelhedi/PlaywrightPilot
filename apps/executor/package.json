{
  "name": "@platform/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "run-all-tests": "node --env-file=../api/.env --import tsx/esm src/examples/run-all-project-tests.ts",
    "dev:worker": "node --env-file=../api/.env --import tsx/esm --watch src/worker.ts",
    "dev:demo": "node --env-file=../api/.env --import tsx/esm src/examples/capture-homepage.ts",
    "test:memory": "node --env-file=../api/.env --import tsx/esm src/examples/test-memory.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@platform/agent-memory": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/database": "workspace:*",
    "@platform/logger": "workspace:*",
    "@platform/queue": "workspace:*",
    "@playwright/test": "^1.62.0",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
